{
  "name": "lg-webos-streamdeck-plugin",
  "version": "0.3.1",
  "private": false,
  "description": "LG webOS TV control plugin for Elgato Stream Deck and Stream Deck + dials.",
  "scripts": {
    "check": "node --check com.leland.lg-webos-control.sdPlugin/bin/plugin.js",
